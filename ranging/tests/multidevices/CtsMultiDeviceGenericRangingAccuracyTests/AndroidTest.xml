<configuration description="CTS multi-device tests for Ranging APIs (UWB, Bluetooth, Wi-Fi RTT).">

    <option name="test-suite-tag" value="cts-v-host" />
    <option name="test-suite-tag" value="mts-uwb" />

    <option name="config-descriptor:metadata" key="component" value="uwb" />
    <option name="config-descriptor:metadata" key="parameter" value="not_instant_app" />
    <option name="config-descriptor:metadata" key="parameter" value="not_multi_abi" />

    <device name="AndroidDevice">
        <target_preparer class="AndroidDeviceFeaturesCheckDecorator">
            <option name="forbidden_feature" value="android.hardware.type.automotive" />
        </target_preparer>
        <target_preparer class="AndroidInstallAppsDecorator" />
    </device>

    <device name="AndroidDevice">
        <target_preparer class="AndroidDeviceFeaturesCheckDecorator">
            <option name="forbidden_feature" value="android.hardware.type.automotive" />
        </target_preparer>
        <target_preparer class="AndroidInstallAppsDecorator" />
    </device>

    <test class="MoblyAospTest" />

    <option name="mobly_pkg" key="file" value="CtsMultiDeviceGenericRangingAccuracyTests" />

    <option name="build_apk" key="file" value="mobly-bundled-snippets.apk" />
    <option name="build_apk" key="file" value="bluetooth_multi_devices_snippet.apk" />
    <option name="build_apk" key="file" value="ranging_snippet.apk" />
    <option name="build_apk" key="file" value="uwb_snippet.apk" />

</configuration>